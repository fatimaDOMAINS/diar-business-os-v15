{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diar-business-os-core-v15",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": [
      "0 */2 * * *"
    ]
  },
  "vars": {
    "APP_ENV": "development",
    "ALLOW_LEGACY_PARTNER_AUTH": "false",
    "ENABLE_LEGACY_SOLAR": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diar-business-os-dev",
      "database_id": "e0c41136-4608-480a-b7b5-8610e9a04613"
    }
  ],
  "env": {
    "staging": {
      "name": "diar-business-os-core-v15-staging",
      "vars": {
        "APP_ENV": "staging",
        "ALLOW_LEGACY_PARTNER_AUTH": "false",
        "ENABLE_LEGACY_SOLAR": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "diar-business-os-staging",
          "database_id": "aefde3b9-1457-42ab-b14f-c7ec6414f601"
        }
      ]
    },
    "production": {
      "name": "diar-business-os-core",
      "vars": {
        "APP_ENV": "production",
        "ALLOW_LEGACY_PARTNER_AUTH": "false",
        "ENABLE_LEGACY_SOLAR": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "diar-business-os-production",
          "database_id": "608da55e-f250-44c8-a1cd-0d3edd2fea54"
        }
      ]
    }
  }
}
